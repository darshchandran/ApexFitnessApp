# APEX AI backend (npm run ai:server). Copy to .env — never commit .env.
# Server-only: never prefix these with EXPO_PUBLIC_ (that would bundle them into the app).

# Required, no default: "development" or "production". Production refuses to start unless every
# (prod) setting below is present and safe — it never falls back to development behaviour.
APEX_ENV=development

# (prod) Real OpenAI credentials. Model names come only from here; FAST/DEEP fall back to APEX_AI_MODEL.
OPENAI_API_KEY=
APEX_AI_MODEL=
APEX_FAST_MODEL=
APEX_DEEP_MODEL=
# Development only (e.g. a local mock model). Refused in production.
# OPENAI_BASE_URL=

# (prod) Signs access tokens: at least 32 random characters. Rotating it signs every device out of
# its current access token (devices refresh automatically).
APEX_AUTH_SECRET=

# (prod) Postgres / Supabase connection string (server credentials — never the anon key).
# Development without it uses a local Postgres (PGlite) kept in .data/ai-db.
DATABASE_URL=
# (prod) "require": TLS with a verified certificate. DATABASE_CA_CERT: extra CA (PEM text or file path), e.g. Supabase's.
DATABASE_SSL=disable
# DATABASE_CA_CERT=

# (prod) Exact browser origins allowed to call the API (only the web build needs one), comma-separated,
# https:// in production, never "*". "none" = native apps only.
APEX_AI_CORS_ORIGINS=

# (prod) "open": new installs may register an APEX AI identity; "closed": only existing ones.
APEX_AI_REGISTRATION=open

# 1 only behind a reverse proxy that appends the client address to X-Forwarded-For.
APEX_TRUST_PROXY=

PORT=8787
HOST=127.0.0.1
