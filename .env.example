# APEX AI backend (npm run ai:server). Copy to .env — never commit .env.
# Server-only: never prefix these with EXPO_PUBLIC_ (that would bundle them into the app).
OPENAI_API_KEY=
# Model names come only from here (no defaults in code). FAST/DEEP fall back to APEX_AI_MODEL.
APEX_AI_MODEL=
APEX_FAST_MODEL=
APEX_DEEP_MODEL=
# Signs athlete bearer tokens; at least 32 random characters.
APEX_AUTH_SECRET=
PORT=8787
HOST=127.0.0.1
